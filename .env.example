APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

TRIAL_DURATION_HOURS=24

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=analisesprisma
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

CHILLBET_API_URL=https://gestoranalista.gestorbet.com.br
CHILLBET_API_TOKEN=
CHILLBET_API_TIMEOUT=8
CHILLBET_API_CONNECT_TIMEOUT=3
CHILLBET_HISTORY_DEFAULT_LIMIT=300
CHILLBET_HISTORY_MAX_LIMIT=2000
CHILLBET_WS_URL=https://gestoranalista.gestorbet.com.br
CHILLBET_WS_JWT_SECRET=
CHILLBET_WS_TOKEN_TTL=1200
CHILLBET_WS_ORIGIN=analisesprisma

DOUBLE_WS_URL=https://gestoranalista.gestorbet.com.br
DOUBLE_WS_PATH=/double/socket.io
DOUBLE_WS_JWT_SECRET=
DOUBLE_WS_TOKEN_TTL=1200
DOUBLE_WS_TOKEN_ORIGIN=analisesprisma

CRASH_WINDOW_API_URL=
CRASH_WINDOW_API_TOKEN=
CRASH_WINDOW_API_TIMEOUT=8
CRASH_WINDOW_API_CONNECT_TIMEOUT=3
CRASH_WINDOW_API_FUTURE_LIMIT=4
CRASH_WINDOW_API_PREVIOUS_LIMIT=100

HISTORICO_DB_CONNECTION=mariadb
HISTORICO_DB_HOST=127.0.0.1
HISTORICO_DB_PORT=3306
HISTORICO_DB_DATABASE=historico
HISTORICO_DB_USERNAME=
HISTORICO_DB_PASSWORD=
DOUBLE_HISTORY_TIMEZONE=America/Sao_Paulo

DOUBLE_WINDOW_FINALIZATION_GRACE_SECONDS=15
DOUBLE_WINDOW_ESTIMATED_SHOTS_PER_MINUTE=2
DOUBLE_WINDOW_UPCOMING_COUNT=3
DOUBLE_WINDOW_PREVIOUS_COUNT=10
